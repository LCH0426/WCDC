#!/bin/bash

APP_BIN="${TRIM_APPDEST}/bin/wcdc-server"
DATA_DIR="${TRIM_PKGVAR}"
PID_FILE="${DATA_DIR}/wcdc.pid"
LOG_FILE="${DATA_DIR}/service.log"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
GATEWAY_PREFIX="/app/wcdc"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >>"${LOG_FILE}"
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status_process() {
    [ -r "${PID_FILE}" ] || return 1
    local pid
    pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
    if check_process "${pid}"; then
        return 0
    fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if status_process; then
        return 0
    fi

    mkdir -p "${DATA_DIR}"
    cd "${TRIM_APPDEST}" || {
        echo "应用目录不存在：${TRIM_APPDEST}" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
        return 1
    }

    local share_path="${TRIM_DATA_SHARE_PATHS%%:*}"
    export WCDC_DATA_DIR="${DATA_DIR}"
    export WCDC_UNIX_SOCKET="${SOCKET_PATH}"
    export WCDC_GATEWAY_PREFIX="${GATEWAY_PREFIX}"
    export WCDC_COOKIE_PATH="${GATEWAY_PREFIX}"
    export WCDC_FNOS_MODE=1
    export WCDC_ALLOWED_PATHS="${TRIM_DATA_ACCESSIBLE_PATHS}:${TRIM_DATA_SHARE_PATHS}"
    if [ -n "${share_path}" ]; then
        local escaped_share
        escaped_share=$(printf '%s' "${share_path}" | sed 's/\\/\\\\/g; s/"/\\"/g')
        export WCDC_VOLUMES=$(printf '[{"id":"downloads","name":"WCDC 下载","path":"%s"}]' "${escaped_share}")
    fi

    log_msg "starting ${APP_BIN} on ${SOCKET_PATH}"
    if command -v setsid >/dev/null 2>&1; then
        setsid "${APP_BIN}" >>"${LOG_FILE}" 2>&1 &
    else
        nohup "${APP_BIN}" >>"${LOG_FILE}" 2>&1 &
    fi
    local pid=$!
    echo "${pid}" >"${PID_FILE}"

    local count=0
    while [ "${count}" -lt 30 ]; do
        if [ -S "${SOCKET_PATH}" ]; then
            log_msg "started pid=${pid} socket=${SOCKET_PATH}"
            return 0
        fi
        if ! check_process "${pid}"; then
            log_msg "process exited during startup"
            rm -f "${PID_FILE}"
            echo "WCDC 启动失败，请查看 ${LOG_FILE}" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
            return 1
        fi
        sleep 1
        count=$((count + 1))
    done

    log_msg "startup timed out"
    kill -TERM "${pid}" 2>/dev/null
    kill -TERM -- "-${pid}" 2>/dev/null
    rm -f "${PID_FILE}"
    echo "WCDC 启动超时，请查看 ${LOG_FILE}" >>"${TRIM_TEMP_LOGFILE:-/dev/null}"
    return 1
}

stop_process() {
    mkdir -p "${DATA_DIR}"
    log_msg "stopping process"
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null
            kill -TERM -- "-${pid}" 2>/dev/null
            local count=0
            while check_process "${pid}" && [ "${count}" -lt 15 ]; do
                sleep 1
                count=$((count + 1))
            done
            if check_process "${pid}"; then
                log_msg "force killing pid=${pid}"
                kill -KILL "${pid}" 2>/dev/null
                kill -KILL -- "-${pid}" 2>/dev/null
            fi
        fi
        rm -f "${PID_FILE}"
    fi
    rm -f "${SOCKET_PATH}"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status_process; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" >>"${LOG_FILE}"
    exit 1
    ;;
esac
